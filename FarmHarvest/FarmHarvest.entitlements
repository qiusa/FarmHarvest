<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>MWYKGVPTJP.com.yixin.farmharvest</string>
	</array>
	<!-- 导入 / 导出备份需要读写「用户通过面板自行选择」的文件。
	     缺这一项时沙盒会直接拒绝 NSSavePanel / NSOpenPanel 选中的 URL，
	     表现为点击导出/导入没有任何反应。 -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- 本地通知（收菜到点提醒）需要。沙盒 App 缺这一项时
	     UNUserNotificationCenter 的 add() 会静默失败，一条通知都发不出来。 -->
	<key>com.apple.security.personal-information</key>
	<true/>
</dict>
</plist>
